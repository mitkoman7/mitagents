import asyncio
import json
from datetime import datetime, timedelta
from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import Tool, TextContent
import httpx

# Create MCP server
app = Server("soccer-mcp-server")

# Football-Data.org API configuration
SOCCER_API_URL = "https://api.football-data.org/v4"
SOCCER_API_KEY = "6860618448ab49f686839e09f2c09e30"

async def fetch_soccer_data(endpoint: str):
    """Fetch data from Football-Data.org API"""
    headers = {"X-Auth-Token": SOCCER_API_KEY}
    
    async with httpx.AsyncClient() as client:
        try:
            response = await client.get(
                f"{SOCCER_API_URL}/{endpoint}",
                headers=headers,
                timeout=15.0
            )
            
            if response.status_code == 200:
                return response.json()
            elif response.status_code == 429:
                return {"error": "API rate limit exceeded"}
            elif response.status_code == 403:
                return {"error": "API key invalid"}
            else:
                return {"error": f"API returned status {response.status_code}"}
        except Exception as e:
            return {"error": str(e)}

# Team name to ID mapping
TEAM_MAPPING = {
    "manchester united": 66,
    "man united": 66,
    "liverpool": 64,
    "arsenal": 57,
    "chelsea": 61,
    "manchester city": 65,
    "man city": 65,
    "tottenham": 73,
    "spurs": 73,
    "newcastle": 67,
    "west ham": 563,
    "everton": 62,
    "aston villa": 58,
    "brighton": 397,
}

@app.list_tools()
async def list_tools() -> list[Tool]:
    """List all available soccer tools"""
    return [
        Tool(
            name="get_latest_results",
            description="Get latest Premier League match results from the last few days",
            inputSchema={
                "type": "object",
                "properties": {
                    "days": {
                        "type": "integer",
                        "description": "Number of days to look back (1-10)",
                        "default": 3
                    }
                }
            }
        ),
        Tool(
            name="get_team_recent_matches",
            description="Get recent matches for a specific team (Manchester United, Liverpool, Arsenal, Chelsea, etc)",
            inputSchema={
                "type": "object",
                "properties": {
                    "team_name": {
                        "type": "string",
                        "description": "Team name (e.g., 'Manchester United', 'Liverpool', 'Arsenal')"
                    }
                },
                "required": ["team_name"]
            }
        ),
        Tool(
            name="get_league_standings",
            description="Get current Premier League standings",
            inputSchema={
                "type": "object",
                "properties": {}
            }
        ),
        Tool(
            name="get_todays_matches",
            description="Get today's scheduled Premier League matches",
            inputSchema={
                "type": "object",
                "properties": {}
            }
        )
    ]

@app.call_tool()
async def call_tool(name: str, arguments: dict) -> list[TextContent]:
    """Handle tool calls"""
    
    if name == "get_latest_results":
        days = arguments.get("days", 3)
        
        # Calculate date range
        date_to = datetime.now().strftime("%Y-%m-%d")
        date_from = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d")
        
        # Fetch from API
        data = await fetch_soccer_data(
            f"competitions/PL/matches?status=FINISHED&dateFrom={date_from}&dateTo={date_to}"
        )
        
        if "error" in data:
            return [TextContent(
                type="text",
                text=json.dumps({
                    "error": data["error"],
                    "note": "Check your API key or try again later"
                }, indent=2)
            )]
        
        matches = data.get("matches", [])
        
        if not matches:
            return [TextContent(
                type="text",
                text=json.dumps({
                    "message": f"No finished matches found in the last {days} days",
                    "suggestion": "Try increasing the number of days"
                }, indent=2)
            )]
        
        # Format results
        results = []
        for match in matches:
            home_score = match.get('score', {}).get('fullTime', {}).get('home')
            away_score = match.get('score', {}).get('fullTime', {}).get('away')
            
            results.append({
                "date": match.get("utcDate", "")[:10],
                "home_team": match.get("homeTeam", {}).get("name", "Unknown"),
                "away_team": match.get("awayTeam", {}).get("name", "Unknown"),
                "score": f"{home_score}-{away_score}" if home_score is not None else "N/A",
                "status": match.get("status", "UNKNOWN")
            })
        
        response = {
            "league": "Premier League",
            "days_back": days,
            "matches_found": len(results),
            "results": results
        }
        
        return [TextContent(
            type="text",
            text=json.dumps(response, indent=2)
        )]
    
    elif name == "get_team_recent_matches":
        team_name = arguments.get("team_name", "").lower()
        
        # Find team ID
        team_id = TEAM_MAPPING.get(team_name)
        
        if not team_id:
            available_teams = [t.title() for t in TEAM_MAPPING.keys()]
            return [TextContent(
                type="text",
                text=json.dumps({
                    "error": f"Team '{team_name}' not found",
                    "available_teams": available_teams[:15],
                    "note": "Try one of the teams listed above"
                }, indent=2)
            )]
        
        # Fetch team matches
        data = await fetch_soccer_data(f"teams/{team_id}/matches?status=FINISHED&limit=10")
        
        if "error" in data:
            return [TextContent(
                type="text",
                text=json.dumps({"error": data["error"]}, indent=2)
            )]
        
        matches = data.get("matches", [])
        
        # Format results
        results = []
        for match in matches[:5]:  # Last 5 matches
            home_team = match.get("homeTeam", {}).get("name", "Unknown")
            away_team = match.get("awayTeam", {}).get("name", "Unknown")
            home_score = match.get('score', {}).get('fullTime', {}).get('home')
            away_score = match.get('score', {}).get('fullTime', {}).get('away')
            
            results.append({
                "date": match.get("utcDate", "")[:10],
                "home_team": home_team,
                "away_team": away_team,
                "score": f"{home_score}-{away_score}" if home_score is not None else "N/A",
                "competition": match.get("competition", {}).get("name", "Unknown")
            })
        
        response = {
            "team": team_name.title(),
            "recent_matches": results
        }
        
        return [TextContent(
            type="text",
            text=json.dumps(response, indent=2)
        )]
    
    elif name == "get_league_standings":
        # Fetch standings
        data = await fetch_soccer_data("competitions/PL/standings")
        
        if "error" in data:
            return [TextContent(
                type="text",
                text=json.dumps({"error": data["error"]}, indent=2)
            )]
        
        standings = data.get("standings", [])
        if not standings:
            return [TextContent(
                type="text",
                text=json.dumps({"error": "No standings data available"}, indent=2)
            )]
        
        table = standings[0].get("table", [])
        
        # Format standings
        results = []
        for position in table:
            results.append({
                "position": position.get("position"),
                "team": position.get("team", {}).get("name"),
                "played": position.get("playedGames"),
                "won": position.get("won"),
                "drawn": position.get("draw"),
                "lost": position.get("lost"),
                "points": position.get("points"),
                "goal_difference": position.get("goalDifference")
            })
        
        response = {
            "league": "Premier League",
            "updated": datetime.now().strftime("%Y-%m-%d"),
            "standings": results
        }
        
        return [TextContent(
            type="text",
            text=json.dumps(response, indent=2)
        )]
    
    elif name == "get_todays_matches":
        today = datetime.now().strftime("%Y-%m-%d")
        
        # Fetch today's matches
        data = await fetch_soccer_data(f"competitions/PL/matches?dateFrom={today}&dateTo={today}")
        
        if "error" in data:
            return [TextContent(
                type="text",
                text=json.dumps({"error": data["error"]}, indent=2)
            )]
        
        matches = data.get("matches", [])
        
        if not matches:
            return [TextContent(
                type="text",
                text=json.dumps({
                    "message": "No Premier League matches scheduled for today",
                    "date": today
                }, indent=2)
            )]
        
        # Format results
        results = []
        for match in matches:
            results.append({
                "time": match.get("utcDate", "")[:16].replace('T', ' '),
                "home_team": match.get("homeTeam", {}).get("name"),
                "away_team": match.get("awayTeam", {}).get("name"),
                "status": match.get("status")
            })
        
        response = {
            "date": today,
            "matches_today": len(results),
            "matches": results
        }
        
        return [TextContent(
            type="text",
            text=json.dumps(response, indent=2)
        )]
    
    else:
        return [TextContent(
            type="text",
            text=json.dumps({"error": f"Unknown tool: {name}"})
        )]

async def main():
    """Run the MCP server using stdio"""
    async with stdio_server() as (read_stream, write_stream):
        await app.run(
            read_stream,
            write_stream,
            app.create_initialization_options()
        )

if __name__ == "__main__":
    asyncio.run(main())